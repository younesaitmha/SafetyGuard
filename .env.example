# Local profile that stays close to production behavior
# Copy to .env and customize secrets.

# --- API runtime ---
APP_HOST=0.0.0.0
APP_PORT=8080

# --- Auth mode (prod-like but local-usable) ---
# Keep dev_mode off to avoid unconditional permissive behavior.
APP_DEV_MODE=false

# Do not require external JWKS in local unless you have an IdP.
# This keeps token parsing enabled without remote signature validation.
APP_JWT_VERIFY_SIGNATURE=false
APP_REQUIRE_BEARER_TOKEN=true
APP_JWT_ISSUER=https://your-issuer.example.com/
APP_JWT_AUDIENCE=llm-api

# --- Admin access ---
# Required for /admin/* endpoints via X-Admin-Key header.
APP_ADMIN_API_KEY=change-this-local-admin-key

# Keep OFF for prod-like local behavior.
APP_ADMIN_ALLOW_LOCALHOST_FALLBACK=false

# --- Guard model ---
APP_GUARD_LLM_ENABLED=true
APP_GUARD_LLM_BASE_URL=http://localhost:11434/v1
APP_GUARD_LLM_API_KEY=dummy
APP_GUARD_LLM_MODEL=qwen2.5
APP_LLM_PII_TREATMENT_ONLY=true
